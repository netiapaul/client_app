PORT=3000

# CHOKIDAR_USEPOLLING makes the file watcher stat every watched file on a timer instead of using
# the OS's native change events. It is needed on network drives, Docker volumes and WSL, where
# native events do not fire across the filesystem boundary — and on a local Windows disk it is
# pure cost: node_modules here is ~119,000 files.
#
# Measured on this machine, warm cache: ON 54s to compile, OFF 20-30s. Turn it back on only if
# edits genuinely stop triggering a rebuild (which would mean the project has moved onto a share).
# CHOKIDAR_USEPOLLING=true
# REACT_APP_URL_CONFIG=http://102.37.102.247:5028
#REACT_APP_URL_CONFIG=http://corebasevm.southafricanorth.cloudapp.azure.com:5023
REACT_APP_URL_CONFIG=https://localhost:44376
